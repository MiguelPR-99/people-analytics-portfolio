/// Hecho global con una fila por corte de calidad; es la fuente de registros evaluados, registros con excepción y actualización.
table 'Cortes de calidad'
	lineageTag: ac7c5d38-6b35-46ce-82e1-2ab7aa42c08e

	/// Total global de registros evaluados en los cortes visibles. Es una métrica global y no responde a regla ni sistema fuente.
	measure 'Registros evaluados' = SUM('Cortes de calidad'[Registros evaluados base])
		formatString: #,##0
		displayFolder: Volumen
		lineageTag: 34a7a055-6ded-423f-b221-f5d1443990b8

	/// Total global de registros que presentaron al menos una excepción en los cortes visibles.
	measure 'Registros con excepción' = SUM('Cortes de calidad'[Registros con excepción base])
		formatString: #,##0
		displayFolder: Volumen
		lineageTag: 2688afc8-0c2d-4baa-ab46-3e25589a39e9

	/// Registros evaluados en la fecha máxima visible; evita sumar varios cortes en una tarjeta.
	measure 'Registros evaluados actuales' =
			VAR _snapshotActual = MAX('Fecha'[Fecha de snapshot])
			RETURN
			    CALCULATE(
			        [Registros evaluados],
			        KEEPFILTERS('Fecha'[Fecha de snapshot] = _snapshotActual)
			    )
		formatString: #,##0
		displayFolder: KPI actuales
		lineageTag: d77c5de2-5425-46bd-ba12-555dbd0cc0a7

	/// Registros con excepción en la fecha máxima visible; evita sumar varios cortes en una tarjeta.
	measure 'Registros con excepción actuales' =
			VAR _snapshotActual = MAX('Fecha'[Fecha de snapshot])
			RETURN
			    CALCULATE(
			        [Registros con excepción],
			        KEEPFILTERS('Fecha'[Fecha de snapshot] = _snapshotActual)
			    )
		formatString: #,##0
		displayFolder: KPI actuales
		lineageTag: be048b18-f599-48d8-99fd-a2b3afabfa1f

	/// Proporción global de registros con excepción en el corte máximo visible. No debe interpretarse como promedio de reglas.
	measure 'Tasa de excepción actual' = DIVIDE([Registros con excepción actuales], [Registros evaluados actuales])
		formatString: 0.0%
		displayFolder: KPI actuales
		lineageTag: b302121e-c15d-4913-8155-31ee9b5ed548

	/// Momento de cálculo del corte máximo visible.
	measure 'Última actualización' =
			VAR _snapshotActual = MAX('Fecha'[Fecha de snapshot])
			RETURN
			    CALCULATE(
			        MAX('Cortes de calidad'[Fecha de cálculo]),
			        KEEPFILTERS('Fecha'[Fecha de snapshot] = _snapshotActual)
			    )
		formatString: dd/MM HH:mm
		displayFolder: KPI actuales
		lineageTag: 491073ac-80cd-4d3a-b5fd-b136a36b4c97

	column 'Fecha de snapshot'
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: 78d3dc1b-90e4-4ece-984b-823f6ad3e3e8
		summarizeBy: none
		sourceColumn: SnapshotDate

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column 'Checks elegibles'
