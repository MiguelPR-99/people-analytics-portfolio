/// Hecho de instancias de excepción por corte. Conserva las claves necesarias para recurrencia y cobertura de publicación.
table Excepciones
	lineageTag: c890ac4d-dee8-4f71-b936-dc6c2de04302

	/// Conteo distinto de instancias de excepción en el contexto Gold visible.
	measure 'Instancias de excepción' = DISTINCTCOUNT('Excepciones'[Instancia de excepción ID])
		formatString: #,##0
		displayFolder: Excepciones
		lineageTag: 328e566e-a29a-467f-8a62-b71229bfd435

	/// Claves observadas desde el primer corte hasta la fecha máxima visible, conservando regla, sistema y severidad.
	measure '# Claves de recurrencia' =
			VAR _snapshotMaximo = MAX('Fecha'[Fecha de snapshot])
			VAR _claves =
			    CALCULATETABLE(
			        VALUES('Excepciones'[Clave de recurrencia]),
			        REMOVEFILTERS('Fecha'),
			        'Excepciones'[Fecha de snapshot] <= _snapshotMaximo
			    )
			RETURN
			    COUNTROWS(_claves)
		formatString: #,##0
		isHidden
		displayFolder: Recurrencia
		lineageTag: c42647a6-29a3-4442-8eee-5b2fccb24628

	/// Claves presentes en al menos dos cortes dentro de la ventana histórica hasta la fecha máxima visible.
	measure '# Claves recurrentes' =
			VAR _snapshotMaximo = MAX('Fecha'[Fecha de snapshot])
			VAR _claves =
			    CALCULATETABLE(
			        VALUES('Excepciones'[Clave de recurrencia]),
			        REMOVEFILTERS('Fecha'),
			        'Excepciones'[Fecha de snapshot] <= _snapshotMaximo
			    )
			VAR _clavesConCortes =
			    ADDCOLUMNS(
			        _claves,
			        "__Cortes",
			            CALCULATE(
			                DISTINCTCOUNT('Excepciones'[Fecha de snapshot]),
			                REMOVEFILTERS('Fecha'),
			                'Excepciones'[Fecha de snapshot] <= _snapshotMaximo
			            )
			    )
			RETURN
			    COUNTROWS(FILTER(_clavesConCortes, [__Cortes] >= 2))
		formatString: #,##0
		isHidden
		displayFolder: Recurrencia
		lineageTag: ea23569d-18bc-4463-924d-cf13b3aadfe5

	/// Proporción de claves con presencia en dos o más cortes dentro de la ventana histórica visible.
	measure 'Tasa de recurrencia' = DIVIDE([# Claves recurrentes], [# Claves de recurrencia])
		formatString: 0.0%
		displayFolder: Recurrencia
		lineageTag: 40d9d5e9-a262-4860-ab63-8da290d6ac10

