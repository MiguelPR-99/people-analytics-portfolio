/// Hecho con una fila por corte, regla y sistema fuente; permite explicar el score y los checks fallidos.
table 'Desempeño de reglas'
	lineageTag: b401fd94-624c-4394-8721-ee46d8592384

	/// Score ponderado recalculado desde numerador y denominador; responde a fecha, regla y sistema fuente.
	measure 'Data Quality Score' = DIVIDE(SUM('Desempeño de reglas'[Aprobado ponderado]), SUM('Desempeño de reglas'[Elegible ponderado]))
		formatString: 0.0%
		displayFolder: Calidad
		lineageTag: 3668314a-4193-44d7-bf3a-7c04b0200af3

	/// Data Quality Score en la fecha máxima visible.
	measure 'Data Quality Score actual' =
			VAR _snapshotActual = MAX('Fecha'[Fecha de snapshot])
			RETURN
			    CALCULATE(
			        [Data Quality Score],
			        KEEPFILTERS('Fecha'[Fecha de snapshot] = _snapshotActual)
			    )
		formatString: 0.0%
		displayFolder: Calidad
		lineageTag: 2a575720-8eb4-4bc8-8ace-d879583d1909

	/// Score del corte global inmediatamente anterior a la fecha máxima visible, conservando filtros válidos de regla y sistema.
	measure 'DQ Score anterior' =
			VAR _snapshotActual = MAX('Fecha'[Fecha de snapshot])
			VAR _snapshotAnterior =
			    CALCULATE(
			        MAX('Cortes de calidad'[Fecha de snapshot]),
			        REMOVEFILTERS('Fecha'),
			        'Cortes de calidad'[Fecha de snapshot] < _snapshotActual
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_snapshotAnterior),
			        CALCULATE(
			            [Data Quality Score],
			            REMOVEFILTERS('Fecha'),
			            TREATAS({_snapshotAnterior}, 'Fecha'[Fecha de snapshot])
			        )
			    )
		formatString: 0.0%
		displayFolder: Calidad
		lineageTag: eba60158-f3f0-4dfa-a104-236e7a147d5a

	/// Cambio del score actual frente al corte anterior expresado en puntos porcentuales.
	measure 'Variación DQ Score (pp)' =
			VAR _actual = [Data Quality Score actual]
			VAR _anterior = [DQ Score anterior]
			RETURN
			    IF(
			        NOT ISBLANK(_actual) && NOT ISBLANK(_anterior),
			        (_actual - _anterior) * 100
			    )
		formatString: +0.0;-0.0;0.0 "pp"
		displayFolder: Calidad
		lineageTag: e76e5822-ee1a-4aa3-a96b-3442a5885608

	/// Número de comprobaciones que no cumplieron la regla en el contexto visible.
	measure 'Checks fallidos' = SUM('Desempeño de reglas'[Checks fallidos base])
		formatString: #,##0
		displayFolder: Volumen
		lineageTag: edb50007-22eb-4c2d-8667-81839a3f83f4

	column 'Fecha de snapshot'
